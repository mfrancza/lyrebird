# ALSA configuration for Lyrebird
# Copy to /etc/asound.conf or ~/.asoundrc

# Default to the HAT card
defaults.pcm.card 1
defaults.ctl.card 1

# Low-latency software mixer (dmix)
pcm.!default {
    type plug
    slave.pcm "dmixer"
}

pcm.dmixer {
    type dmix
    ipc_key 1024
    ipc_perm 0666
    slave {
        pcm "hw:1,0"
        period_time 0
        period_size 128
        buffer_size 512
        rate 44100
        channels 2
    }
    bindings {
        0 0
        1 1
    }
}

# Direct hardware access (bypasses dmix for lowest latency)
pcm.direct {
    type hw
    card 1
    device 0
}

# Capture device
pcm.capture {
    type hw
    card 1
    device 0
}

ctl.!default {
    type hw
    card 1
}
